# =============================================================================
# EduFix PK — Environment Variables Template
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# =============================================================================

# --- Supabase (Project Settings -> API / Database) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct connection string (Session pooler, port 5432). Used by db:migrate / db:seed.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# --- Google Gemini (embeddings: gemini-embedding-001, vision/OCR: gemini-2.5-flash) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_VISION_MODEL=gemini-2.5-flash

# --- Groq (primary LLM for generation/grading, OpenAI-compatible) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-key
GROQ_MODEL=openai/gpt-oss-120b
# groq-sdk appends /openai/v1 automatically; keep this as the host root.
GROQ_BASE_URL=https://api.groq.com

# --- RAG Retrieval Guardrail ---
# Minimum cosine similarity for kb_chunks retrieval (PRD 3.2). Rejects trigger fallback.
RAG_SIMILARITY_THRESHOLD=0.78

# Embedding vector size, pinned via outputDimensionality; must match kb_chunks.embedding.
EMBEDDING_DIMENSIONS=768

# Query embedding provider. Must match the model used to embed kb_chunks.
# gemini = Google Gemini gemini-embedding-001 (recommended by TASKS.md)
# local  = Xenova/all-mpnet-base-v2 via scripts/manual-ingest.ts
# Current kb_chunks were embedded locally, so default to "local".
EMBEDDING_PROVIDER=local
